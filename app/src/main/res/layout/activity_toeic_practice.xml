<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FD">

    <LinearLayout
        android:id="@+id/layoutToeicPracticeTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="42dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnToeicPracticeBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="#292B3D"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tvToeicPracticeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="TOEIC Practice"
            android:textColor="#202239"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvToeicTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱ 45:00"
            android:textColor="#D95050"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutToeicProgress"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutToeicPracticeTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvToeicPart"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="PART 5"
            android:textColor="#6558E8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvToeicProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="1/30"
            android:textColor="#77798E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollToeicQuestion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutToeicProgress"
        app:layout_constraintBottom_toTopOf="@id/layoutToeicBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvToeicPassage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#EEF0F8"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="#44475A"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvToeicQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Question"
                android:textColor="#242638"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/groupToeicAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <RadioButton
                    android:id="@+id/radioToeicA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="8dp"
                    android:text="A."
                    android:textColor="#3E4053"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioToeicB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="8dp"
                    android:text="B."
                    android:textColor="#3E4053"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioToeicC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="8dp"
                    android:text="C."
                    android:textColor="#3E4053"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioToeicD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="8dp"
                    android:text="D."
                    android:textColor="#3E4053"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvToeicFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#EEF7F0"
                android:lineSpacingExtra="3dp"
                android:padding="15dp"
                android:textColor="#345344"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToeicCheckOrSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="KIỂM TRA"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#6558E8"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutToeicBottom"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToeicPrevious"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="TRƯỚC"
            android:textColor="#6558E8"
            app:backgroundTint="#F0EDFF"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToeicBookmark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1.2"
            android:text="☆ Đánh dấu"
            android:textAllCaps="false"
            android:textColor="#A46B08"
            app:backgroundTint="#FFF7E8"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToeicNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="TIẾP"
            android:textColor="#FFFFFF"
            app:backgroundTint="#6558E8"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
