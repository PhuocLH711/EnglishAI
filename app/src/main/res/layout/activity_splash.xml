<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSplash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF9">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- LOGO ENGLISHAI -->
        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:adjustViewBounds="true"
            android:contentDescription="EnglishAI Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_englishai" />

        <!-- THANH LOADING -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSplash"
            android:layout_width="220dp"
            android:layout_height="6dp"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            app:indicatorColor="#63C7E8"
            app:trackColor="#DDF4FB"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tvSplashLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Đang khởi động..."
            android:textColor="#8A8A96"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>