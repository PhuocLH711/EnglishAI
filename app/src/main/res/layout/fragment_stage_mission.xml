<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Nút Quay về -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackToHome"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_quiz"
            android:backgroundTint="#ECEFF1"
            android:text="⬅️ BẢN ĐỒ"
            android:textColor="#37474F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:elevation="0dp"/>
    </LinearLayout>

    <!-- Khung thông tin Ải -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <!-- Biểu tượng hoành tráng -->
            <TextView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:text="⚔️"
                android:textSize="60sp"
                android:gravity="center"
                android:background="@drawable/bg_button_quiz"
                android:backgroundTint="#FFF3E0"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvStageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ải 1: Khởi Động"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvStageDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Cấp độ: Dễ"
                android:textColor="#E65100"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="24dp"/>

            <!-- Danh sách thử thách -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F7FA"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhiệm vụ của bạn:"
                    android:textStyle="bold"
                    android:textColor="#37474F"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Trắc nghiệm tiếng Anh"
                    android:textColor="#546E7A"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌨️ Luyện gõ từ vựng"
                    android:textColor="#546E7A"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎧 Nghe và phản xạ"
                    android:textColor="#546E7A"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Nút Bắt đầu khổng lồ -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartBattle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_button_quiz"
        android:backgroundTint="#4CAF50"
        android:text="BẮT ĐẦU CHIẾN ĐẤU 🚀"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="6dp"
        android:layout_marginBottom="24dp"/>

</LinearLayout>