<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardToeicStudentTest"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#E6E7F1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvToeicStudentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOEIC Full Practice Demo 01"
            android:textColor="#242638"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvToeicStudentSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="EnglishAI Original TOEIC-style Demo"
            android:textColor="#898B9E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvToeicStudentMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="200 câu • 120 phút • Part 1-7"
            android:textColor="#6558E8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvToeicStudentProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tiến độ: 0%"
            android:textColor="#2F6F5E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToeicPractice"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Luyện tập"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:backgroundTint="#6558E8"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToeicMock"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="Thi thử"
                android:textAllCaps="false"
                android:textColor="#6558E8"
                android:textStyle="bold"
                app:backgroundTint="#F0EDFF"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>